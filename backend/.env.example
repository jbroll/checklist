# Server Configuration
PORT=3001
BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# BetterAuth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-key-here

# Jazz Configuration
JAZZ_PEER=wss://cloud.jazz.tools
# Note: JAZZ_API_KEY is automatically loaded from root .env (VITE_JAZZ_API_KEY)
# You don't need to set it here - just configure VITE_JAZZ_API_KEY in root .env

# Jazz Agent/Worker Configuration
# The agent is a server-side Jazz account that can load CoValues and manage group memberships
# To create an agent account:
# 1. Run: npx jazz-run create-worker --peer wss://cloud.jazz.tools
# 2. Save the ACCOUNT_ID and ACCOUNT_SECRET in these variables
JAZZ_AGENT_ACCOUNT_ID=your-jazz-agent-account-id
JAZZ_AGENT_SECRET=your-jazz-agent-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple OAuth
APPLE_CLIENT_ID=your-apple-client-id
APPLE_CLIENT_SECRET=your-apple-client-secret
