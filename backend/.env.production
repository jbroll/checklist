# Backend Production Environment Variables
# DO NOT COMMIT - Create as secrets.env on the server

# Server Configuration
PORT=3001
NODE_ENV=production

# Frontend and API URLs
BASE_URL=https://bubblelist.rkroll.com
FRONTEND_URL=https://bubblelist.rkroll.com

# Jazz Configuration (for Jazz account sync only)
JAZZ_PEER=wss://cloud.jazz.tools

# BetterAuth Secret (REQUIRED - generate a secure random string)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# Google OAuth (REQUIRED - from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Apple OAuth (Optional - from Apple Developer)
# APPLE_CLIENT_ID=your-apple-client-id
# APPLE_CLIENT_SECRET=your-apple-client-secret
