{
  "name": "checklist-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp -r src/migrations dist/",
    "start": "node dist/migrate-auth.js && node dist/index.js",
    "migrate": "node dist/migrate.js",
    "migrate-auth": "node dist/migrate-auth.js",
    "rotate-better-auth-secret": "tsx scripts/rotate-better-auth-secret.ts",
    "rotate-jazz-agent": "tsx scripts/rotate-agent.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "better-auth": "^1.3.7",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jazz-tools": "^0.19.15",
    "nodemailer": "^7.0.11",
    "stripe": "^20.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.15"
  }
}
