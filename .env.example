# BetterAuth Backend URL (IMPORTANT: must match backend PORT)
VITE_AUTH_URL=http://localhost:3001

# Jazz Configuration
VITE_JAZZ_PEER=wss://cloud.jazz.tools

# Jazz API Key (from https://dashboard.jazz.tools)
# This is the SINGLE SOURCE OF TRUTH - backend automatically reads this value
VITE_JAZZ_API_KEY=your-jazz-api-key-here
