#!/usr/bin/env bash
# simple-ci entry: lint + type-check + unit tests (no servers needed).
# Invoked by: sci push checklist/test
set -euo pipefail
WORKTREE="$(cd "$(dirname "$0")/.." && pwd)"
export WORKTREE
# shellcheck disable=SC1091
. "$WORKTREE/ci/setup.sh"
cd "$WORKTREE"
# simple-ci rsyncs the worktree WITHOUT node_modules — install both the root
# (frontend) and the separate backend npm project.
npm install
( cd backend && npm install )
npm run lint
npm run type-check
"${ORG_HOOKS:-$HOME/src/org-hooks}/scripts/flake-run.sh" unit
