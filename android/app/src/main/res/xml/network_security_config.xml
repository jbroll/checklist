<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Disable cleartext (HTTP) traffic for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Certificate pinning for critical domains -->
    <domain-config>
        <domain includeSubdomains="true">checklist.rkroll.com</domain>
        <domain includeSubdomains="true">rowboat.rkroll.com</domain>
        <domain includeSubdomains="true">api.stripe.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
