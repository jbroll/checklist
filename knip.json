{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["openssl", "python3"],
  "ignoreDependencies": ["dpdm"],
  "workspaces": {
    ".": {
      "entry": [
        "src/**/index.ts",
        "*.config.{ts,js,mjs}",
        "e2e/**/*.{ts,tsx}",
        "test-helpers/**/*.ts",
        "scripts/**/*.{ts,js,mjs}"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,tsx}", "test-helpers/**/*.ts"],
      "ignore": [
        "src/components/ui/FeatureErrorBoundary.tsx",
        "src/components/ui/badge.tsx",
        "src/components/ui/empty-state.tsx",
        "src/lib/types.ts",
        "src/lib/useLongPressIndicator.ts"
      ]
    },
    "backend": {
      "entry": ["src/migrate.ts", "src/migrate-auth.ts", "scripts/**/*.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["cors", "helmet", "nodemailer", "zod", "tailwind-merge"]
    }
  }
}
