{
  "name": "bubblelist",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "cd backend && npm run dev",
    "build": "tsc --noEmit && vite build --mode production",
    "build:backend": "cd backend && npm run build",
    "build:production": "npm run build && npm run build:backend && npm run prepare:deploy",
    "prepare:deploy": "mkdir -p deploy-backend && cp -r backend/dist deploy-backend/ && cp backend/package.json backend/package-lock.json deploy-backend/ && cp backend/.env.example deploy-backend/.env.example 2>/dev/null || true",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node scripts/generate-screenshots.js",
    "generate-pwa-assets": "npm run generate-icons && npm run generate-screenshots",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "mock-oauth": "tsx scripts/start-mock-oauth.ts",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint && npm run test:run",
    "check:staged": "lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "tsc-files --noEmit"
    ],
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --write"
    ]
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.8",
    "better-auth": "^1.3.7",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-fuzzy": "^1.12.0",
    "framer-motion": "^11.11.17",
    "jazz-tools": "^0.18.33",
    "lucide-react": "^0.462.0",
    "nanoid": "^5.1.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "vite-plugin-pwa": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.5",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.6",
    "@vitest/ui": "^4.0.6",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.2.6",
    "marked": "^17.0.1",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.15",
    "tsc-files": "^1.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^6.4.1",
    "vitest": "^4.0.6"
  }
}
